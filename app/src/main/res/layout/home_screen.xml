<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/safe_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingBottom="28dp"
        android:paddingLeft="56dp"
        android:paddingRight="56dp"
        android:paddingTop="28dp">

        <LinearLayout
            android:id="@+id/topbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/glass_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="7dp"
            android:paddingRight="12dp">

            <ImageView
                android:id="@+id/profile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_bg"
                android:clickable="true"
                android:contentDescription="@string/profiles"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/profile_avatar" />

            <TextView
                android:id="@+id/tab_home"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginLeft="14dp"
                android:background="@drawable/tab_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="@string/tab_home"
                android:textColor="@color/tab_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_search"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/tab_bg"
                android:clickable="true"
                android:drawableLeft="@drawable/ic_search"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="16dp"
                android:text="@string/tab_search"
                android:textColor="@color/tab_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_library"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/tab_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="@string/tab_library"
                android:textColor="@color/tab_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_store"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/tab_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="@string/tab_store"
                android:textColor="@color/tab_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/wifi_btn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/pill_bg"
                android:clickable="true"
                android:contentDescription="@string/network"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="9dp"
                android:paddingRight="9dp">

                <ImageView
                    android:id="@+id/wifi"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_wifi" />

                <TextView
                    android:id="@+id/wifi_ping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bt_btn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/pill_bg"
                android:clickable="true"
                android:contentDescription="@string/bluetooth"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="9dp"
                android:paddingRight="9dp">

                <ImageView
                    android:id="@+id/bt_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_bluetooth" />

                <TextView
                    android:id="@+id/bt_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/settings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/btn_bg"
                android:clickable="true"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:gravity="right"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEE d MMM"
                    android:format24Hour="EEE d MMM"
                    android:includeFontPadding="false"
                    android:textAllCaps="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/hero"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/hero_art"
                        android:layout_width="300dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="right"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop" />

                    <View
                        android:id="@+id/hero_fade"
                        android:layout_width="304dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="right" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginRight="250dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingBottom="14dp"
                        android:paddingLeft="24dp"
                        android:paddingTop="14dp">

                        <TextView
                            android:id="@+id/hero_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/chip_bg"
                            android:paddingBottom="3dp"
                            android:paddingLeft="9dp"
                            android:paddingRight="9dp"
                            android:paddingTop="3dp"
                            android:text="@string/hero_featured"
                            android:textColor="#FFFFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hero_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#FFFFFFFF"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hero_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/hero_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#B3FFFFFF"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:clipChildren="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/hero_play"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/btn_primary"
                                android:clickable="true"
                                android:drawableLeft="@drawable/ic_play_dark"
                                android:drawablePadding="6dp"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="18dp"
                                android:paddingRight="20dp"
                                android:text="@string/open"
                                android:textColor="#FF111827"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/hero_all"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginLeft="10dp"
                                android:background="@drawable/btn_secondary"
                                android:clickable="true"
                                android:drawableLeft="@drawable/ic_grid"
                                android:drawablePadding="6dp"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="16dp"
                                android:paddingRight="20dp"
                                android:text="@string/all_apps"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/hero_info"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginLeft="10dp"
                                android:background="@drawable/btn_bg"
                                android:clickable="true"
                                android:contentDescription="@string/app_info"
                                android:focusable="true"
                                android:padding="8dp"
                                android:src="@drawable/ic_info" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/hero_border"
                        android:focusable="false" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/right_col"
                    android:layout_width="200dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="12dp"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/weather_card"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="16dp"
                        android:paddingRight="12dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/weather_city"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:letterSpacing="0.1"
                                android:maxLines="1"
                                android:textAllCaps="true"
                                android:textColor="#B3FFFFFF"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/weather_temp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textColor="#FFFFFFFF"
                                android:textSize="34sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/weather_desc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#B3FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/weather_icon"
                            android:layout_width="46dp"
                            android:layout_height="46dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/media_card"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_card"
                        android:orientation="vertical"
                        android:paddingBottom="12dp"
                        android:paddingLeft="14dp"
                        android:paddingRight="12dp"
                        android:paddingTop="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/media_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#B3FFFFFF"
                            android:textSize="9sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/media_art"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/tile_bg"
                                android:scaleType="centerCrop" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/media_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/media_artist"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="#B3FFFFFF"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/media_toggle"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="@drawable/btn_bg"
                                android:clickable="true"
                                android:contentDescription="@string/play_pause"
                                android:focusable="true"
                                android:padding="6dp"
                                android:src="@drawable/ic_pause" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/media_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="6dp"
                            android:max="1000"
                            android:progressDrawable="@drawable/progress_bar" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/apps_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.12"
                android:text="@string/your_apps"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/apps_row"
                android:layout_width="match_parent"
                android:layout_height="102dp"
                android:layout_marginLeft="-6dp"
                android:layout_marginRight="-6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="1dp"
                android:paddingTop="1dp" />

            <TextView
                android:id="@+id/recent_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.12"
                android:text="@string/continue_watching"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recent_row"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginLeft="-6dp"
                android:layout_marginRight="-6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="1dp"
                android:paddingTop="1dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/library"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/library_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="-6dp"
                android:layout_marginRight="-6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:paddingTop="8dp" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bt_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC05070B"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:paddingBottom="22dp"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/bt_title"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bt_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bt_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/bt_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bt_add"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="22dp"
                    android:paddingRight="22dp"
                    android:text="@string/bt_add"
                    android:textColor="#FF111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bt_close"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="22dp"
                    android:paddingRight="22dp"
                    android:text="@string/close"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/speed_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC05070B"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/panel_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="22dp"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/speed_title"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="#FFFFFFFF"
                android:textSize="56sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speed_phase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mbps"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/speed_label_ping"
                        android:textColor="#99FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/speed_ping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/speed_label_download"
                        android:textColor="#99FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/speed_down"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/speed_label_upload"
                        android:textColor="#99FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/speed_up"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/speed_again"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:text="@string/repeat"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/speed_close"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="22dp"
                    android:paddingRight="22dp"
                    android:text="@string/close"
                    android:textColor="#FF111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
