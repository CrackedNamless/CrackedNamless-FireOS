<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#EB0C0C0E" android:startColor="#F01C1C20" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
